# ── OrcAgent environment ──
# Copied to /etc/orcagent.env by deploy/install.sh. Fill in the values, then
# start the service. Readable only by root and the orcagent user.
#
# Copy each value from your Railway Variables tab. Where a value already
# exists there, use THAT value -- do not generate a new one.

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — the app refuses to start without these
# ─────────────────────────────────────────────────────────────────────

# THE critical one. Every user's trading key in the database is encrypted
# with this. Copy it from Railway exactly. A new key does not "reset"
# anything -- it makes every stored wallet permanently unreadable, and the
# funds in them unreachable through this app.
ENCRYPTION_KEY=

# Signs login sessions. A new value here just logs everyone out once.
SECRET_KEY=

# Wallets with full admin rights. Accepts a comma-separated list.
OWNER_WALLET=

# ─────────────────────────────────────────────────────────────────────
# STRONGLY RECOMMENDED
# ─────────────────────────────────────────────────────────────────────

# Solana RPC. The public endpoint rate-limits hard; use Helius or similar.
SOLANA_RPC_URL=
HELIUS_API_KEY=

# Required for every EVM swap and bridge (BSC, Base, Arbitrum, Polygon,
# Robinhood Chain). Without it those chains cannot trade at all.
ZEROX_API_KEY=

# AI token scoring and the X buzz discovery. Without credit on this key,
# both features go quiet -- everything else keeps working.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# GAS SPONSORSHIP — lets a USDC-only wallet trade at all
# ─────────────────────────────────────────────────────────────────────
# Keep these funded; their addresses are printed at startup.
GAS_SPONSOR_PRIVATE_KEY=
SOL_GAS_SPONSOR_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────────
BIRDEYE_API_KEY=
BSC_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
ROBINHOOD_RPC_URL=

# X (Twitter) sharing. The callback URL must match the X Developer Portal
# exactly -- including the new domain if you are changing it.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=

# Passkey/WebAuthn domain. Must be the domain users actually visit.
WEBAUTHN_RP_ID=orcagent.fun

# Uptime alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Port gunicorn binds to. nginx forwards to this; leave it unless you also
# change deploy/nginx-orcagent.conf and deploy/orcagent.service.
PORT=8080
